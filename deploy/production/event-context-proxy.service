[Unit]
Description=Event-driven Context HTTPS proxy
After=network-online.target event-context.service
Wants=network-online.target
Conflicts=caddy.service caddy-api.service

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/event-context-proxy
Environment=XDG_CONFIG_HOME=/var/lib/event-context-proxy
StateDirectory=event-context-proxy
ExecStart=/usr/bin/caddy run --config /etc/caddy/event-context.Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/event-context.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
